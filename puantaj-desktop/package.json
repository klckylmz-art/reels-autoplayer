{
  "name": "bar-puantaj-portable",
  "version": "1.0.0",
  "description": "Portable Windows puantaj application with JSON persistence",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.puantaj.bar",
    "productName": "Puantaj",
    "asar": true,
    "files": ["app/**/*", "package.json"],
    "win": {"target": [{"target":"portable","arch":["x64"]}]},
    "portable": {"artifactName": "Puantaj-Portable.exe"}
  }
}
