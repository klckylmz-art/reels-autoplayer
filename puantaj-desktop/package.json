{
  "name": "hayal-kahvesi-puantaj",
  "version": "1.1.0",
  "description": "Hayal Kahvesi portable Windows puantaj application with JSON persistence",
  "main": "app/main-patched.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hayalkahvesi.puantaj",
    "productName": "Hayal Kahvesi Puantaj",
    "asar": true,
    "files": ["app/**/*", "package.json"],
    "win": {"target": [{"target":"portable","arch":["x64"]}]},
    "portable": {"artifactName": "Puantaj.exe"}
  }
}
