<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#0A0A0B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instagram Reels AutoPlayer"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instagram'ın kendi uygulamasının üstünde çalışır. WebView ve ayrı Instagram girişi yoktur."
        android:textSize="15sp"
        android:textColor="#BBBBBB"
        android:gravity="center"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="1. ACCESSIBILITY İZNİNİ AÇ"
        android:layout_marginTop="32dp"/>

    <Button
        android:id="@+id/btnInstagram"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="2. INSTAGRAM'I AÇ"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzin açılınca Instagram üzerinde küçük kontrol paneli görünecek."
        android:textColor="#8ED49A"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="24dp"/>
</LinearLayout>
